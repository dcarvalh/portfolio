# Copy to .dev.vars for local testing (npm run dev). .dev.vars is git-ignored.
# Cloudflare Turnstile test keys: always pass. Use secret 2x0000000000000000000000000000000AA to test a failure.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Any long random string, e.g. from: openssl rand -hex 32
DOWNLOAD_SIGNING_KEY=change-me
